<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/editNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/phone_number_input_hint"
        android:inputType="phone" />

    <Button
        android:id="@+id/btnCall"
        style="@style/NavButtonActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_button_text"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/txtLifecycle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/life_cycle_title"
        android:paddingTop="12dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/bottomBarMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnToMain"
            style="@style/NavButtonActive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/nav_button_main" />

        <Button
            android:id="@+id/btnToContacts"
            style="@style/NavButtonInactive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/nav_button_contacts" />

    </LinearLayout>
</LinearLayout>
